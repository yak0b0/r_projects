POSTSEASON == "R64"       ~ 64,
POSTSEASON == "R68"       ~ 68,
POSTSEASON == "N/A"       ~ 400,
))
View(data)
data <- data %>%
mutate(POSTSEASON = replace_na(POSTSEASON, "N/A"),
SEED = replace_na(SEED, "N/A"))
data <- data %>%
mutate(WIN_P = W/G)
View(data)
